# Helmet/Security Headers
ENABLE_SECURITY_HEADERS=true

# ============================================================
# FEATURE FLAGS
# ============================================================
VITE_ENABLE_B2B=true
VITE_ENABLE_MENTORING=true
VITE_ENABLE_STARTUPS=true
VITE_ENABLE_CHECKIN=true
VITE_ENABLE_LIVE_STREAM=false
VITE_ENABLE_CHAT=false

# ============================================================
# CONFIGURAÇÕES DO EVENTO
# ============================================================
EVENT_NAME="Growth Summit 2026"
EVENT_DATE_START=2026-05-21
EVENT_DATE_END=2026-05-22
EVENT_LOCATION="Boulevard Hotel, Juazeiro do Norte - CE"
EVENT_MAX_PARTICIPANTS=1500

# ============================================================
# URLs DE REDIRECIONAMENTO
# ============================================================
URL_SUCCESS_PAYMENT=http://localhost:5173/pagamento/sucesso
URL_CANCEL_PAYMENT=http://localhost:5173/pagamento/cancelado
URL_CHECKIN=http://localhost:5173/checkin

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. NUNCA commite o arquivo .env real no git
# 2. Use .env.local para variáveis locais específicas
