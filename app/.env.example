# GROWTH SUMMIT 2026 - Environment Variables (Example)
# Renomeie para .env e preencha os valores reais
#
# ⚠️  IMPORTANTE: Este arquivo deve conter APENAS variáveis VITE_* (públicas do cliente).
#     Secrets de servidor devem ser configurados diretamente no Vercel Dashboard:
#       → Settings → Environment Variables
#
#     Variáveis que devem ir APENAS no Vercel (NUNCA neste arquivo):
#       - SUPABASE_SERVICE_ROLE_KEY
#       - DATABASE_URL
#       - RESEND_API_KEY
#       - STRIPE_SECRET_KEY

# APLICAÇÃO
VITE_APP_NAME="Growth Experience 2026"
VITE_APP_URL=https://www.growthexperience.site
VITE_API_URL=https://www.growthexperience.site/api
VITE_ENVIRONMENT=production

# SUPABASE (apenas chaves públicas - a ANON KEY é segura para o cliente)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-key

# FEATURE FLAGS
VITE_ENABLE_B2B=true
VITE_ENABLE_MENTORING=true
VITE_ENABLE_STARTUPS=true
VITE_ENABLE_CHECKIN=true

# CONFIGURAÇÕES DO EVENTO
VITE_EVENT_NAME="Growth Experience 2026"
VITE_EVENT_DATE_START=2026-04-16
VITE_EVENT_DATE_END=2026-04-16
VITE_EVENT_LOCATION="Espaço Parque, Triunfo - PE"
VITE_EVENT_MAX_PARTICIPANTS=3000

# STRIPE (chave pública - pk_live_... ou pk_test_...)
# VITE_STRIPE_PUBLIC_KEY=pk_live_...

# SEGURANÇA: Domínios e emails com acesso admin automático
VITE_ADMIN_DOMAINS=growthsummit.site,cbxgrowth.com.br
VITE_ADMIN_EMAILS=projetos@cbxgrowth.com.br
