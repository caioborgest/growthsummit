# GROWTH SUMMIT 2026 - Environment Variables (Example)
# Renomeie para .env e preencha os valores reais

# APLICAÇÃO
VITE_APP_NAME="Growth Experience 2026"
VITE_APP_URL=https://www.growthexperience.site
VITE_API_URL=https://www.growthexperience.site/api
VITE_ENVIRONMENT=production
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# BANCO DE DADOS (Prisma/Migrations)
DATABASE_URL="postgresql://postgres:senha@db.projeto.supabase.co:5432/postgres"

# EMAIL (Resend)
RESEND_API_KEY=re_sua_chave

# FEATURE FLAGS
VITE_ENABLE_B2B=true
VITE_ENABLE_MENTORING=true
VITE_ENABLE_STARTUPS=true
VITE_ENABLE_CHECKIN=true

# CONFIGURAÇÕES DO EVENTO
VITE_EVENT_NAME="Growth Summit 2026"
VITE_EVENT_DATE_START=2026-05-21
VITE_EVENT_DATE_END=2026-05-22
VITE_EVENT_LOCATION="Boulevard, Barbalha - CE"
VITE_EVENT_MAX_PARTICIPANTS=3000
